<DATAFILE>

[FILEINFO]
file={path='../MeaslesAlbData_Province_2025_2026/MeaslesAlbData_Province_wkly_2025.csv'}
delimiter = comma
header={week_start_date_Ontario, Time_days_Alberta, Time_weeks_Alberta, Y_incidence_Alberta, Ytype, ID}

[CONTENT]
Time_weeks_Alberta = {use=time}
Y_incidence_Alberta = {use=observation, yname='1', type=continuous}
Ytype = {use=observationtype}
ID = {use=identifier}

<MODEL>

[INDIVIDUAL]
input = {I0_pop, ReproNum_pop, S0_pop, gamma_pop, nu_pop}

DEFINITION:
I0 = {distribution=logNormal, typical=I0_pop, no-variability}
ReproNum = {distribution=logNormal, typical=ReproNum_pop, no-variability}
S0 = {distribution=logNormal, typical=S0_pop, no-variability}
gamma = {distribution=logNormal, typical=gamma_pop, no-variability}
nu = {distribution=logNormal, typical=nu_pop, no-variability}

[LONGITUDINAL]
input = {a, b}

file = '../K1_FitR0.txt'

DEFINITION:
y1 = {distribution=normal, prediction=inc, errorModel=combined1(a, b)}

<FIT>
data = '1'
model = y1

<PARAMETER>
I0_pop = {value=8, method=FIXED}
ReproNum_pop = {value=1.85296, method=MLE}
S0_pop = {value=2627.68, method=MLE}
a = {value=5.2276748, method=MLE}
b = {value=0.2248627, method=MLE}
c = {value=1, method=FIXED}
gamma_pop = {value=0.7, method=FIXED}
nu_pop = {value=0.875, method=FIXED}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, npc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, predictiondistribution = {selected = true}, likelihoodcontribution = {selected = true}, saemresults = {selected = true}, fisher = {selected = true}, likelihoodresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = 'K1Fit_R0'

